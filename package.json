{
  "name": "coins-predicts",
  "version": "0.1.0",
  "description": "Hourly Two-Tier VMC crypto screening for human review (research tooling; no trading advice, no orders).",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/main.js)",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "mcp:stdio": "node --env-file-if-exists=.env dist/mcp-stdio.js",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run --project unit --project db",
    "test:live": "vitest run --project live",
    "lint:secrets": "node scripts/check-no-secrets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cron": "4.4.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.12"
  }
}
