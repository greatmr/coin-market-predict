{
  "name": "coins-predicts",
  "version": "0.1.0",
  "description": "Hourly Two-Tier VMC crypto screening for human review (NestJS + TypeORM + PostgreSQL; research tooling; no trading advice, no orders).",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/main.js)",
    "dev": "npm run start:dev",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "mcp:stdio": "node --env-file-if-exists=.env dist/mcp-stdio.js",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/cli.js db:migrate",
    "db:status": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/cli.js db:status",
    "db:revert": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/cli.js db:revert",
    "typeorm": "tsc -p tsconfig.build.json && typeorm -d dist/database/data-source.js",
    "migration:create": "typeorm migration:create",
    "migration:generate": "tsc -p tsconfig.build.json && typeorm -d dist/database/data-source.js migration:generate",
    "migration:show": "tsc -p tsconfig.build.json && typeorm -d dist/database/data-source.js migration:show",
    "migration:run": "tsc -p tsconfig.build.json && typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "tsc -p tsconfig.build.json && typeorm -d dist/database/data-source.js migration:revert",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:db": "npm run test:e2e",
    "test:all": "vitest run --project unit --project e2e",
    "test:live": "vitest run --project live",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:secrets": "node scripts/check-no-secrets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/typeorm": "12.0.2",
    "cron": "4.4.0",
    "decimal.js": "10.6.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.12"
  }
}
