// Coins Predicts — PostgreSQL schema.
// Conventions (see .claude/rules/data-semantics.md):
//  * All timestamps are UTC (timestamptz).
//  * Financial values use Decimal; unavailable values stay NULL with a reason in `nullReasons`.
//  * Observations are keyed by provider + provider asset id + slot + quote currency so data
//    from different providers, quotes, or volume windows is never merged.
//  * Two-Tier VMC strategy tables (docs/strategy-two-tier-vmc.md) carry `providerId` so synthetic
//    fixture data and live CoinMarketCap data never mix; CMC numeric ids are the asset key.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Sources and asset identity
// ---------------------------------------------------------------------------

model Provider {
  id             String   @id // e.g. "fixture", "coinmarketcap_web"
  name           String
  accessMethod   String // official_api | website | fixture | public_dataset
  isLive         Boolean // false for fixtures; dashboards and reports must label non-live data
  baseUrl        String?
  termsUrl       String?
  attribution    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  identities     AssetIdentity[]
  snapshots      MarketSnapshot[]
  discoveryRuns  DiscoveryRun[]
  health         SourceHealth?
}

/// Canonical asset. Identity is never derived from the symbol alone.
model Asset {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  symbol           String
  /// Classification from discovery: regular | stablecoin | tokenized | wrapped | bridged | staked | unknown
  assetClass       String    @default("unknown")
  classSource      String? // provider_category | heuristic_name | heuristic_price | manual
  underlyingAsset  String? // e.g. "bitcoin" for wrapped BTC exposure
  isBenchmark      Boolean   @default(false) // BTC/ETH reference assets
  firstSeenAt      DateTime  @db.Timestamptz(3)
  lastSeenAt       DateTime  @db.Timestamptz(3)
  delistedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  identities       AssetIdentity[]
  contracts        AssetContract[]
  snapshots        MarketSnapshot[]

  @@index([symbol])
  @@index([assetClass])
}

/// Mapping of a provider's asset id to the canonical asset.
model AssetIdentity {
  id              String    @id @default(uuid()) @db.Uuid
  assetId         String    @db.Uuid
  providerId      String
  providerAssetId String
  sourceUrl       String?
  firstSeenAt     DateTime  @db.Timestamptz(3)
  lastSeenAt      DateTime  @db.Timestamptz(3)
  /// Set when the provider no longer lists the asset during a complete discovery sweep.
  delistedAt      DateTime? @db.Timestamptz(3)

  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  provider        Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, providerAssetId])
  @@index([assetId])
}

/// Chain + contract address. EVM addresses are stored lower-cased.
model AssetContract {
  id              String   @id @default(uuid()) @db.Uuid
  assetId         String   @db.Uuid
  chain           String
  contractAddress String
  providerId      String
  decimals        Int?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([chain, contractAddress])
  @@index([assetId])
}

model DiscoveryRun {
  id               String    @id @default(uuid()) @db.Uuid
  providerId       String
  startedAt        DateTime  @db.Timestamptz(3)
  finishedAt       DateTime? @db.Timestamptz(3)
  status           String // running | succeeded | partial | failed
  pagesFetched     Int       @default(0)
  assetsSeen       Int       @default(0)
  newAssets        Int       @default(0)
  delistedAssets   Int       @default(0)
  /// Total the source reports it lists, when the source exposes it. NULL means unknown.
  sourceTotal      Int?
  /// True only when the sweep fetched every page the source offers.
  coverageComplete Boolean   @default(false)
  requestsUsed     Int       @default(0)
  error            String?
  notes            Json?

  provider         Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, startedAt])
}

/// Circuit-breaker and request-budget state per provider (survives restarts).
model SourceHealth {
  providerId          String    @id
  state               String    @default("closed") // closed | open | half_open | suspended
  consecutiveFailures Int       @default(0)
  consecutiveDenials  Int       @default(0)
  openedAt            DateTime? @db.Timestamptz(3)
  retryAfterUntil     DateTime? @db.Timestamptz(3)
  suspendedReason     String?
  lastSuccessAt       DateTime? @db.Timestamptz(3)
  lastFailureAt       DateTime? @db.Timestamptz(3)
  lastStatusCode      Int?
  budgetPeriodStart   DateTime? @db.Timestamptz(3)
  budgetUsed          Int       @default(0)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  provider            Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------------------
// Observations (the existing crawler's stored records)
// ---------------------------------------------------------------------------

model MarketSnapshot {
  id                   BigInt    @id @default(autoincrement())
  assetId              String    @db.Uuid
  providerId           String
  providerAssetId      String
  /// Hourly bucket this observation belongs to (UTC, minute = 0) = the crawl batch slot.
  slotTime             DateTime  @db.Timestamptz(3)
  /// Crawl time (our clock).
  collectedAt          DateTime  @db.Timestamptz(3)
  /// Provider update time (CMC quote `lastUpdated`). NULL if not supplied.
  observedAt           DateTime? @db.Timestamptz(3)
  sourceUrl            String
  quoteCurrency        String    @default("USD")

  price                Decimal?  @db.Decimal(38, 18)
  /// Circulating market cap. Never fully diluted valuation.
  marketCap            Decimal?  @db.Decimal(38, 4)
  /// provider_reported | calculated_from_circulating_supply | unavailable
  marketCapProvenance  String
  fullyDilutedValuation Decimal? @db.Decimal(38, 4)
  circulatingSupply    Decimal?  @db.Decimal(38, 8)
  /// provider_reported | unavailable
  supplyProvenance     String
  /// Rolling 24h trading volume as reported by the provider at observedAt.
  volumeRolling24h     Decimal?  @db.Decimal(38, 4)
  /// Actual volume traded inside this hour (only from sources with hourly bars). Never derived
  /// by subtracting overlapping 24h totals.
  volumeHourly         Decimal?  @db.Decimal(38, 4)
  volumeHourlySource   String?
  /// Provider-reported percentage changes (labeled provider fields, not computed by us).
  providerChangePct1h  Decimal?  @db.Decimal(20, 8)
  providerChangePct24h Decimal?  @db.Decimal(20, 8)
  providerChangePct7d  Decimal?  @db.Decimal(20, 8)
  /// Liquidity fields (NULL unless a source provides them).
  bidAskSpreadPct      Decimal?  @db.Decimal(20, 8)
  depthPlus2PctUsd     Decimal?  @db.Decimal(38, 4)
  depthMinus2PctUsd    Decimal?  @db.Decimal(38, 4)
  liquiditySource      String?
  /// Provider rank at this observation (CMC `cmcRank`). NULL when the source gives none.
  rank                 Int?
  /// Provider first-listing date (CMC `dateAdded`).
  dateAdded            DateTime? @db.Timestamptz(3)
  /// Raw provider tags at this observation (CMC `tags`).
  tags                 String[]  @default([])

  /// Data-quality flags, e.g. ["stale_observation", "missing_market_cap"].
  qualityFlags         String[]
  /// Fraction of core fields present (0..1).
  completeness         Decimal   @db.Decimal(5, 4)
  /// Seconds between observedAt and collectedAt; NULL when observedAt is unknown.
  freshnessSeconds     Int?
  isStale              Boolean   @default(false)
  /// field -> reason for each NULL value.
  nullReasons          Json
  pipelineRunId        String?   @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  asset                Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  provider             Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, providerAssetId, slotTime, quoteCurrency])
  @@index([assetId, slotTime])
  @@index([slotTime])
}

// ---------------------------------------------------------------------------
// Runs
// ---------------------------------------------------------------------------

model PipelineRun {
  id            String    @id @default(uuid()) @db.Uuid
  kind          String // hourly | manual
  slotTime      DateTime  @db.Timestamptz(3)
  providerId    String
  status        String // running | succeeded | partial | failed | skipped | missed
  currentStage  String?
  attempt       Int       @default(1)
  startedAt     DateTime  @db.Timestamptz(3)
  finishedAt    DateTime? @db.Timestamptz(3)
  /// Coverage summary: assets expected/collected/missing/stale and completeness label.
  coverage      Json?
  /// Latencies, missing-field counts, error counts.
  metrics       Json?
  error         String?
  isLiveData    Boolean
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  stages        PipelineStage[]
  deliveries    TelegramDelivery[]

  @@unique([kind, slotTime, providerId])
  @@index([startedAt])
}

model PipelineStage {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @db.Uuid
  stage       String // discover | collect | lbank | daily | scan | venues | export | notify
  status      String // running | succeeded | failed | skipped
  startedAt   DateTime  @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)
  attempts    Int       @default(1)
  detail      Json?
  error       String?

  run         PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stage])
}

/// Small key/value store for durable application state (Telegram access list, bot offset, watermarks).
model AppState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Database-backed lease: prevents overlapping runs across application instances.
model JobLease {
  name        String   @id
  holder      String
  acquiredAt  DateTime @db.Timestamptz(3)
  heartbeatAt DateTime @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------

model TelegramDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  runId             String    @db.Uuid
  /// Hash of the report content; with partIndex and chatId it suppresses duplicates.
  reportHash        String
  partIndex         Int
  partCount         Int
  chatId            String
  mode              String // live | dry_run
  status            String // pending | sent | failed | dry_run
  attempts          Int       @default(0)
  nextAttemptAt     DateTime? @db.Timestamptz(3)
  lastError         String?
  telegramMessageId String?
  text              String
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  sentAt            DateTime? @db.Timestamptz(3)

  run               PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([reportHash, partIndex, chatId])
  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Two-Tier VMC strategy — Tier 1 inputs (docs/tier1-input-mapping.md)
// ---------------------------------------------------------------------------

/// CMC asset identity (PDF p.10): the numeric CMC id is the key; symbol/name/slug/tags are
/// metadata whose changes are logged in CmcAssetChange without creating a new asset.
model CmcAsset {
  providerId      String
  cmcId           Int
  symbol          String
  name            String
  slug            String?
  tags            String[]  @default([])
  dateAdded       DateTime? @db.Timestamptz(3)
  platformChain   String?
  platformAddress String?
  firstSeenAt     DateTime  @db.Timestamptz(3)
  lastSeenAt      DateTime  @db.Timestamptz(3)
  lastBatchId     String?   @db.Uuid
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@id([providerId, cmcId])
  @@index([providerId, symbol])
}

model CmcAssetChange {
  id         BigInt   @id @default(autoincrement())
  providerId String
  cmcId      Int
  /// symbol | name | slug | tags | dateAdded | platform
  field      String
  oldValue   String?
  newValue   String?
  batchId    String?  @db.Uuid
  observedAt DateTime @db.Timestamptz(3)

  @@index([providerId, cmcId, observedAt])
}

/// One crawl batch per provider and UTC hour slot (PDF p.16 crawl_batches).
model CrawlBatch {
  id               String    @id @default(uuid()) @db.Uuid
  providerId       String
  slotTime         DateTime  @db.Timestamptz(3)
  pipelineRunId    String?   @db.Uuid
  isLive           Boolean
  startedAt        DateTime  @db.Timestamptz(3)
  finishedAt       DateTime  @db.Timestamptz(3)
  /// Crawl time of the batch's observations; the Tier 1 rules' as-of time (assumption A1).
  crawledAt        DateTime  @db.Timestamptz(3)
  sourceUpdatedMin DateTime? @db.Timestamptz(3)
  sourceUpdatedMax DateTime? @db.Timestamptz(3)
  /// COMPLETE | INCOMPLETE | FAILED
  status           String
  statusReasons    String[]  @default([])
  /// Assets the source reports it lists (null = unknown).
  listedTotal      Int?
  collected        Int
  /// field -> number of observations with a non-null value.
  fieldCounts      Json
  /// Ranks 1..1200 absent from the batch, and ranks seen more than once.
  missingRanks     Int[]     @default([])
  duplicateRanks   Int[]     @default([])
  errors           Json?
  notes            String[]  @default([])
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, slotTime])
  @@index([providerId, crawledAt])
}

/// Effective completed-UTC-day row per asset (PDF p.11). Every source change is a new revision.
model DailyMetric {
  providerId     String
  cmcId          Int
  dateUtc        DateTime  @db.Date
  revisionId     BigInt    @unique
  revision       Int
  volumeUsd      Decimal?  @db.Decimal(38, 8)
  marketCapUsd   Decimal?  @db.Decimal(38, 8)
  closeUsd       Decimal?  @db.Decimal(38, 18)
  /// volume / market cap for display (computations use the exact stored inputs). NULL when invalid.
  vmc            Decimal?  @db.Decimal(65, 30)
  valid          Boolean
  invalidReasons String[]  @default([])
  sourceCloseAt  DateTime? @db.Timestamptz(3)
  retrievedAt    DateTime  @db.Timestamptz(3)
  source         String
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@id([providerId, cmcId, dateUtc])
}

model DailyMetricRevision {
  id             BigInt    @id @default(autoincrement())
  providerId     String
  cmcId          Int
  dateUtc        DateTime  @db.Date
  revision       Int
  /// first | source_revision
  revisionReason String
  volumeUsd      Decimal?  @db.Decimal(38, 8)
  marketCapUsd   Decimal?  @db.Decimal(38, 8)
  openUsd        Decimal?  @db.Decimal(38, 18)
  highUsd        Decimal?  @db.Decimal(38, 18)
  lowUsd         Decimal?  @db.Decimal(38, 18)
  closeUsd       Decimal?  @db.Decimal(38, 18)
  valid          Boolean
  invalidReasons String[]  @default([])
  periodStart    DateTime? @db.Timestamptz(3)
  periodEnd      DateTime? @db.Timestamptz(3)
  sourceCloseAt  DateTime? @db.Timestamptz(3)
  /// Exact source text of the fields used.
  sourceFields   Json
  /// cmc_web:<route> | manual_csv_import | fixture
  source         String
  sourceParams   Json
  responseSha256 String?
  contentHash    String
  retrievedAt    DateTime  @db.Timestamptz(3)
  batchId        String?   @db.Uuid

  @@unique([providerId, cmcId, dateUtc, revision])
  @@index([providerId, cmcId, dateUtc])
}

/// Last daily-history request per asset, so a missing day is retried on a schedule, not every run.
model DailyFetchState {
  providerId         String
  cmcId              Int
  lastAttemptAt      DateTime  @db.Timestamptz(3)
  lastSuccessAt      DateTime? @db.Timestamptz(3)
  /// ok | partial | failed | no_data
  lastStatus         String
  lastError          String?
  rowsReturned       Int       @default(0)
  latestDateReturned DateTime? @db.Date

  @@id([providerId, cmcId])
}

/// One venue crawl: all LBank Spot pairs (kind lbank_spot_pairs) or one asset's CMC Markets spot
/// pairs (kind asset_markets). `pairs` keeps the normalized rows exactly as used (PDF p.10, p.15).
model VenueCrawl {
  id             String    @id @default(uuid()) @db.Uuid
  providerId     String
  /// lbank_spot_pairs | asset_markets
  kind           String
  cmcId          Int?
  batchId        String?   @db.Uuid
  startedAt      DateTime  @db.Timestamptz(3)
  finishedAt     DateTime  @db.Timestamptz(3)
  /// COMPLETE | INCOMPLETE | FAILED
  status         String
  expectedCount  Int?
  fetchedCount   Int
  requests       Int       @default(0)
  pairs          Json
  summary        Json?
  source         String
  sourceParams   Json
  responseSha256 String[]  @default([])
  error          String?
  notes          String[]  @default([])

  @@index([providerId, kind, finishedAt])
  @@index([providerId, kind, cmcId, finishedAt])
}

/// LBank pair listing transitions (first seen / reappeared / absent in a complete crawl).
model VenuePairEvent {
  id         BigInt   @id @default(autoincrement())
  providerId String
  exchange   String
  cmcId      Int
  marketPair String
  /// LISTED | ABSENT
  event      String
  crawlId    String   @db.Uuid
  at         DateTime @db.Timestamptz(3)

  @@index([providerId, exchange, cmcId, at])
}

/// Human venue decisions (append-only): LBank tradability verification and mapping evidence.
model VenueDecision {
  id         String    @id @default(uuid()) @db.Uuid
  providerId String
  cmcId      Int
  exchange   String
  /// NULL = applies to the asset on this exchange as a whole (only NOT_TRADABLE).
  marketPair String?
  /// VERIFIED_TRADABLE | NOT_TRADABLE | MAPPING_CONFIRMED | MAPPING_REJECTED
  decision   String
  reviewer   String
  note       String?
  batchId    String?   @db.Uuid
  decidedAt  DateTime  @db.Timestamptz(3)

  @@index([providerId, cmcId, exchange, decidedAt])
}

/// Saved mapping-evidence task for an ambiguous LBank base ticker (PDF p.10).
model VenueMappingTask {
  id                   String    @id @default(uuid()) @db.Uuid
  providerId           String
  cmcId                Int
  exchange             String
  marketPair           String
  /// SYMBOL_MISMATCH | TICKER_MULTIPLE_IDS
  kind                 String
  evidence             Json
  /// OPEN | RESOLVED
  status               String
  firstSeenBatchId     String?   @db.Uuid
  lastSeenBatchId      String?   @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  resolvedAt           DateTime? @db.Timestamptz(3)
  resolvedByDecisionId String?   @db.Uuid

  @@unique([providerId, cmcId, exchange, marketPair, kind])
  @@index([providerId, status])
}

// ---------------------------------------------------------------------------
// Two-Tier VMC strategy — Tier 1 results and human reviews
// ---------------------------------------------------------------------------

/// Processing of one crawl batch (counts, warnings, queue status, export). Reprocessing updates it.
model ScanRun {
  batchId          String    @id @db.Uuid
  providerId       String
  isLive           Boolean
  rulesetVersion   String
  configVersion    String
  overridesVersion String
  attempts         Int       @default(1)
  startedAt        DateTime  @db.Timestamptz(3)
  finishedAt       DateTime? @db.Timestamptz(3)
  /// running | succeeded | failed
  status           String
  asOf             DateTime  @db.Timestamptz(3)
  /// PUBLISHED | WITHHELD_INCOMPLETE_BATCH | WITHHELD_LBANK_UNAVAILABLE | EMPTY
  queueStatus      String?
  counts           Json?
  warnings         String[]  @default([])
  lbankCrawlId     String?   @db.Uuid
  /// succeeded | failed
  exportStatus     String?
  exportPath       String?
  exportFiles      Json?
  exportedAt       DateTime? @db.Timestamptz(3)
  error            String?
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  @@index([providerId, asOf])
}

/// One Tier 1 result per (crawl batch, CMC id) (PDF p.12, p.16, p.17). Raw inputs and source
/// timestamps sit beside every computed value; N/A values are NULL with a reason code.
model ScanResult {
  id                 BigInt    @id @default(autoincrement())
  batchId            String    @db.Uuid
  providerId         String
  cmcId              Int
  symbol             String
  name               String
  slug               String?
  rank               Int?
  dateAdded          DateTime? @db.Timestamptz(3)
  ageDays            Decimal?  @db.Decimal(14, 6)
  priceUsd           Decimal?  @db.Decimal(38, 18)
  capUsd             Decimal?  @db.Decimal(38, 8)
  volume24hUsd       Decimal?  @db.Decimal(38, 8)
  /// Provider update time of the current quote.
  observedAt         DateTime? @db.Timestamptz(3)
  /// Crawl time of the current quote.
  crawledAt          DateTime  @db.Timestamptz(3)
  /// OK | STALE | TIMESTAMP_UNVERIFIED | MISMATCHED | MISSING | INVALID
  currentStatus      String
  currentReason      String?
  currentVmc         Decimal?  @db.Decimal(65, 30)
  vmc3dAvg           Decimal?  @db.Decimal(65, 30)
  vmc7dAvg           Decimal?  @db.Decimal(65, 30)
  vmc14dAvg          Decimal?  @db.Decimal(65, 30)
  vmc30dAvg          Decimal?  @db.Decimal(65, 30)
  avg3dReason        String?
  avg7dReason        String?
  avg14dReason       String?
  avg30dReason       String?
  multiple3d         Decimal?  @db.Decimal(65, 30)
  multiple7d         Decimal?  @db.Decimal(65, 30)
  multiple30d        Decimal?  @db.Decimal(65, 30)
  /// YES | NO | N/A
  pass3d             String
  pass7d             String
  pass30d            String
  reason3d           String?
  reason7d           String?
  reason30d          String?
  stars              Int
  /// ELIGIBLE | EXCLUDED | NEEDS_REVIEW
  eligibilityStatus  String
  eligibilityReasons String[]  @default([])
  /// regular | stablecoin | tokenized | ambiguous
  assetClass         String
  classSource        String?
  /// VERIFIED | PAIR_LISTED_UNVERIFIED | NOT_LISTED | NOT_TRADABLE | UNKNOWN
  lbankStatus        String
  lbankReason        String?
  lbankPairs         Json
  /// PENDING until a reviewer decides (reviews hold ACCEPT / REJECT)
  venueReview        String
  venueFlags         String[]  @default([])
  flags              String[]  @default([])
  inQueue            Boolean   @default(false)
  queueOrder         Int?
  diagnostics        Json?
  /// Dates, values and daily revision ids used (lineage).
  dailyWindow        Json?
  inputsHash         String
  rulesetVersion     String
  configVersion      String
  /// Scan (processing) time.
  computedAt         DateTime  @db.Timestamptz(3)

  @@unique([batchId, cmcId])
  @@index([batchId, eligibilityStatus])
  @@index([batchId, inQueue])
  @@index([providerId, cmcId, crawledAt])
}

/// Human review record (Tier 1 venue/event-day decisions and Tier 2 chart review + trade plan).
/// Append-only: every save is a new revision; earlier decisions are never overwritten (PDF p.16, p.27).
model Review {
  id                String    @id @default(uuid()) @db.Uuid
  providerId        String
  cmcId             Int
  /// Tier 1 crawl batch the review refers to.
  batchId           String    @db.Uuid
  revision          Int
  supersedesId      String?   @db.Uuid
  reviewer          String
  reviewedAt        DateTime  @db.Timestamptz(3)
  /// ACCEPT | REJECT | PENDING
  venueDecision     String
  venueNote         String?
  /// FIRST | SECOND | LATER | UNKNOWN
  eventDay          String
  lbankPair         String?
  chartExchange     String?
  chartSymbol       String?
  chartQuote        String?
  chartUrl          String?
  chartTimezone     String?
  chartProxyReason  String?
  chartTimestamp    DateTime? @db.Timestamptz(3)
  /// PASS | REJECT | UNCERTAIN
  rangeLow          String?
  chartHistory      String?
  priorPumpResponse String?
  /// PRE_MOVE | ALREADY_PUMPED | UNCERTAIN
  candleState       String?
  /// FAVORABLE | UNFAVORABLE | UNCERTAIN
  marketRegime      String?
  /// REVIEW | NO_TRADE | PLAN_READY
  finalDecision     String
  rationale         String?
  plan              Json?
  /// COMPLETE | INCOMPLETE (PLAN_READY only)
  planStatus        String?
  validation        Json
  /// Copy of the Tier 1 record at review time (inputs, source timestamps, windows, pairs).
  tier1Snapshot     Json

  @@unique([providerId, cmcId, batchId, revision])
  @@index([providerId, cmcId, reviewedAt])
}
