# Coins Predicts web container. ${VARS} are filled from the environment at start (see Dockerfile).
# The API sees the browser's Host header unchanged ($http_host, port included): its write guard
# compares it with the Origin header.

# The client's scheme as the host's reverse proxy saw it (TLS ends there), else this hop's.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Self-hosted scripts, styles and fonts only; CMC logos as images; the TradingView chart only as a
# sandboxed cross-origin iframe. CSP_CONNECT_SRC adds the API origin when it is on another host.
map $host $dashboard_csp {
    default "default-src 'self'; img-src 'self' data: https://s2.coinmarketcap.com; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self' ${CSP_CONNECT_SRC}; frame-src https://www.tradingview-widget.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 10m;

    # Docker's DNS, so the API container is looked up per request (it may restart with a new IP)
    # and nginx starts even while the API is still coming up.
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $api_upstream "${API_UPSTREAM}";

    # Runtime config for the bundle: where the API is (empty = this origin).
    location = /app-config.json {
        default_type application/json;
        expires -1;
        include /etc/nginx/snippets/security-headers.conf;
        return 200 '{ "apiBase": "${API_BASE_URL}" }';
    }

    location = /web-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # REST API, MCP (Streamable HTTP) and the API's liveness probe, on the same origin.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 300s;
    }
    location /mcp {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
    location = /healthz {
        proxy_pass $api_upstream;
        access_log off;
    }

    # Hashed build files never change: cache for a year.
    location /assets/ {
        expires 1y;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Every other path is a dashboard route (/queue, /coins/1027, …): serve the app shell.
    location / {
        expires -1;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
    }
}
