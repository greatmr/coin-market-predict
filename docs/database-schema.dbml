Ref agent_analysis_batch_id_fkey: agent_analysis.(batch_id) > crawl_batch.(id) [delete: restrict]
Ref agent_analysis_provider_id_fkey: agent_analysis.(provider_id) > provider.(id) [delete: restrict]
Ref agent_analysis_requested_by_id_fkey: agent_analysis.(requested_by_id) > app_user.(id) [delete: set null]
Ref asset_contract_asset_id_fkey: asset_contract.(asset_id) > asset.(id) [delete: restrict]
Ref asset_contract_provider_id_fkey: asset_contract.(provider_id) > provider.(id) [delete: restrict]
Ref asset_identity_asset_id_fkey: asset_identity.(asset_id) > asset.(id) [delete: restrict]
Ref asset_identity_provider_id_fkey: asset_identity.(provider_id) > provider.(id) [delete: restrict]
Ref cmc_asset_last_batch_id_fkey: cmc_asset.(last_batch_id) > crawl_batch.(id) [delete: set null]
Ref cmc_asset_provider_id_fkey: cmc_asset.(provider_id) > provider.(id) [delete: restrict]
Ref cmc_asset_change_batch_id_fkey: cmc_asset_change.(batch_id) > crawl_batch.(id) [delete: set null]
Ref cmc_asset_change_provider_id_fkey: cmc_asset_change.(provider_id) > provider.(id) [delete: restrict]
