Table agent_analysis {
  id uuid [pk, default: `gen_random_uuid()`]
  provider_id text [not null]
  cmc_id integer [not null]
  symbol text [not null]
  name text [not null]
  batch_id uuid [not null]
  is_live boolean [not null]
  requested_by text [not null]
  requested_by_id uuid
  requested_at "timestamp with time zone" [not null]
  finished_at "timestamp with time zone"
  status agent_run_status [not null]
  counts_toward_limit boolean [not null, default: `true`]
  model text [not null]
  fallback_model text
  effort text [not null]
  prompt_version text [not null]
  ruleset_version text [not null]
  outlook agent_outlook
  confidence agent_confidence
  output jsonb
  guardrail_notes "text[]" [not null, default: `'{}'::text[]`]
  tool_calls jsonb [not null]
  usage jsonb
  error_kind text
  error_message text

  indexes {
    (provider_id, cmc_id, requested_at) [name: 'ix_agent_analysis_coin']
    requested_at [name: 'ix_agent_analysis_requested']
  }

  Note: '''agent_analysis_finished_consistent: CHECK (((status = \'RUNNING\'::agent_run_status) = (finished_at IS NULL)))\nagent_analysis_success_has_output: CHECK (((status <> \'SUCCEEDED\'::agent_run_status) OR ((output IS NOT NULL) AND (outlook IS NOT NULL) AND (confidence IS NOT NULL))))'''
}

