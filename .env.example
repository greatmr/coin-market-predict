# Coins Predicts configuration. Copy to .env and adjust. NEVER commit real secrets.
# Every secret can alternatively be supplied as <NAME>_FILE=/path/to/file (Docker secrets).
# Strategy: Two-Tier VMC (docs/strategy-two-tier-vmc.md). Operator guide: docs/operator-guide.md.

# --- Core ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://coins:coins_dev_password@127.0.0.1:5433/coins?schema=public
# Separate database used by `npm run test:db` (created automatically if missing).
TEST_DATABASE_URL=postgresql://coins:coins_dev_password@127.0.0.1:5433/coins_test?schema=public
# Storage is always UTC; this only affects display.
DISPLAY_TIMEZONE=Asia/Tehran

# --- Market data --------------------------------------------------------------------
# Sources are enabled explicitly; fixture remains the offline default. See docs/source-feasibility.md.
# fixture           = clearly labeled SYNTHETIC market (default, works offline, ids >= 990001)
# coinmarketcap_web = CMC website listing + daily history + LBank / asset market pairs (no key).
#                     The only live source that supplies everything Tier 1 needs.
# coinmarketcap     = CMC Basic API listing only (free key): no daily history or LBank pairs,
#                     so every window is N/A and every coin needs review
# coingecko         = CoinGecko Demo API listing only (free key; non-commercial terms)
DATA_SOURCE=fixture
CMC_API_KEY=
COINGECKO_API_KEY=
# Official API budgets (1 request = 1 page = 1 credit with the page sizes we use).
SOURCE_REQUESTS_PER_MINUTE=10
SOURCE_MONTHLY_REQUEST_BUDGET=9000
SOURCE_MAX_MARKET_PAGES_PER_RUN=10
DISCOVERY_INTERVAL_HOURS=24
# Website collector: one shared sequential queue for listing, daily history, LBank pairs and
# asset market pairs.
CMC_WEB_REQUESTS_PER_MINUTE=30
# Local politeness budget for all website routes. Tier 1 needs ~720 listing requests per month,
# 2 per LBank list refresh (every LBANK_PAIRS_REFRESH_DAYS) and about one daily-history request
# per screen candidate per UTC day (~300-1,100 candidates). Each run keeps a reserve for the
# hourly listing.
CMC_WEB_MONTHLY_REQUEST_BUDGET=30000
CMC_WEB_MAX_RETRIES=2
CMC_WEB_CACHE_SECONDS=60
# 10000 returns the whole ~8k listing in one response (verified 2026-11-03).
CMC_WEB_LISTING_PAGE_SIZE=10000

# --- Pipeline -----------------------------------------------------------------------
SCHEDULER_ENABLED=true
# Minute 7 of every hour, UTC. One crawl batch per UTC hour.
PIPELINE_CRON=7 * * * *
# current_slot: on restart, run the current hour if it has not completed. Past hours are
# recorded as missed (never backfilled with invented data).
MISSED_RUN_POLICY=current_slot
# The crawler's documented batch interval (PDF p.12). A current quote older than
# MAX_QUOTE_AGE_MINUTES (default 2 x interval = 120) is STALE and its windows are N/A.
CRAWL_EXPECTED_INTERVAL_MINUTES=60
# MAX_QUOTE_AGE_MINUTES=120
# 0 = never delete snapshots by age.
RETENTION_SNAPSHOT_DAYS=0
# After N days: coins outside the Tier 1 rank band keep one snapshot per UTC day and scan rows
# excluded only by rank/cap keep the first batch of each UTC day. 0 keeps all detail.
RETENTION_DETAIL_DAYS=30

# --- Two-Tier VMC, Tier 1 -----------------------------------------------------------
# Completed UTC days requested per daily-history refresh (>= 30; extra days catch revisions).
TIER1_DAILY_LOOKBACK_DAYS=35
# Bounds for the daily-history stage per run; unfinished coins continue next run.
TIER1_DAILY_MAX_ASSETS_PER_RUN=1500
TIER1_DAILY_MAX_MINUTES=30
# Retry a coin whose latest completed day was not returned after this many hours.
TIER1_DAILY_RETRY_HOURS=3
# LBank Spot markets list (Markets section of CMC's LBank exchange page): fetched once, then
# again when it is this many days old, or on demand (dashboard button / npm run cli -- lbank:refresh).
LBANK_PAIRS_REFRESH_DAYS=30
# Beyond this age the list is stale: LBank status UNKNOWN and the Review Queue withheld.
LBANK_PAIRS_MAX_AGE_DAYS=35
# false = a pair in that list counts as tradable (operator decision D1).
# true  = every listed pair also needs your "Verified tradable" in the dashboard.
LBANK_REQUIRE_MANUAL_VERIFICATION=false
# CMC Markets venue rows (Upbit-dominant / single-venue flags) for review candidates.
TIER1_VENUE_REFRESH_HOURS=24
TIER1_VENUE_MAX_ASSETS_PER_RUN=60
# Versioned classification / LBank mapping overrides (reviewed changes only).
TIER1_OVERRIDES_FILE=config/tier1-overrides.json
# Per-batch CSV + XLSX exports; files older than EXPORT_RETENTION_DAYS are pruned (DB keeps results).
TIER1_EXPORT_DIR=var/exports
EXPORT_RETENTION_DAYS=7

# --- Telegram -----------------------------------------------------------------------
# disabled | dry_run | live   (live requires both values below)
TELEGRAM_MODE=dry_run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot commands /report /status /vmc /run /help (web server only).
TELEGRAM_COMMANDS_ENABLED=true
# Review Queue rows shown in the hourly summary.
TELEGRAM_QUEUE_ROWS=10
# xlsx = attach the batch's Excel workbook (Review_Queue, All_Eligible, Needs_Review, Excluded,
# Run_Metadata; ~2 MB) after each summary. Not attached when the queue is withheld. none = text only.
TELEGRAM_ATTACH_EXPORT=xlsx

# --- MCP and dashboard --------------------------------------------------------------
MCP_HTTP_ENABLED=true
# Bearer tokens for the HTTP MCP endpoint (read-only tools). Leave empty to disable over HTTP.
MCP_READ_TOKEN=
MCP_WRITE_TOKEN=
# Optional "user:password" for dashboard Basic auth (required if HOST is not loopback).
# Reviews and LBank decisions can be saved only on loopback or with Basic auth.
DASHBOARD_BASIC_AUTH=
