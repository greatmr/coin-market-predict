# Coins Predicts configuration. Copy to .env and adjust. NEVER commit real secrets.
# Every secret can alternatively be supplied as <NAME>_FILE=/path/to/file (Docker secrets).

# --- Core ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://coins:coins_dev_password@127.0.0.1:5433/coins?schema=public
# Separate database used by `npm run test:db` (created automatically if missing).
TEST_DATABASE_URL=postgresql://coins:coins_dev_password@127.0.0.1:5433/coins_test?schema=public
# Storage is always UTC; this only affects display.
DISPLAY_TIMEZONE=Asia/Tehran

# --- Market data --------------------------------------------------------------------
# Sources are enabled explicitly; fixture remains the offline default.
# See docs/source-feasibility.md and docs/volume-mcap.md.
# fixture       = clearly labeled synthetic data (default, works offline)
# coinmarketcap_web = website listing/page collector (no API key)
# coinmarketcap = CoinMarketCap Basic API (free key; recommended live option)
# coingecko     = CoinGecko Demo API (free key; non-commercial terms, see docs)
DATA_SOURCE=fixture
CMC_API_KEY=
COINGECKO_API_KEY=
# Conservative request budget (1 request = 1 page = 1 credit with the page sizes we use).
# CMC Basic: 15,000 credits/month, 50 req/min. CoinGecko Demo: 10,000 calls/month, 100/min.
SOURCE_REQUESTS_PER_MINUTE=10
SOURCE_MONTHLY_REQUEST_BUDGET=9000
# Pages per hourly run. Official APIs: CMC page = 200 assets, CoinGecko page = 250 assets;
# 10 pages x 730 runs/month = 7,300 requests and covers the top ~2,000-2,500 (PARTIAL).
# Website collector: page = CMC_WEB_LISTING_PAGE_SIZE, so one request reads every listed coin.
SOURCE_MAX_MARKET_PAGES_PER_RUN=10
# Genuine hourly history (one chart request per coin, 72 h each) for every coin that would be
# eligible now but lacks t-1h/t-2h: the first run, newly qualifying coins, gaps after downtime.
# Bounded per run by coin count and minutes; never spends the request budget the hourly listing
# still needs this month; continues next run. 0 disables (coins then warm up over 3 runs).
SOURCE_HISTORY_BOOTSTRAP_MAX_ASSETS=1500
SOURCE_HISTORY_BOOTSTRAP_MAX_MINUTES=35
DISCOVERY_INTERVAL_HOURS=24
# Shared by website listing, coin pages, daily history and hourly backfill (sequential queue).
# 30/min lets the first run backfill ~800 strategy coins in about 30 minutes; later runs need
# only 1 listing request plus history for new coins.
CMC_WEB_REQUESTS_PER_MINUTE=30
CMC_WEB_MONTHLY_REQUEST_BUDGET=9000
CMC_WEB_MAX_RETRIES=2
CMC_WEB_CACHE_SECONDS=60
# 10000 returns the whole ~8k listing in one response (verified 2026-11-03). Smaller pages are
# unstable among the thousands of coins tied at zero market cap, so coverage may be partial.
CMC_WEB_LISTING_PAGE_SIZE=10000

# --- Pipeline -----------------------------------------------------------------------
SCHEDULER_ENABLED=true
# Minute 7 of every hour, UTC (gives the source time to refresh the hour).
PIPELINE_CRON=7 * * * *
# current_slot: on restart, run the current hour if it has not completed. Past hours are
# recorded as missed (never backfilled with invented data).
MISSED_RUN_POLICY=current_slot
# "Three historical records" = snapshots at t, t-1h, t-2h.
SNAPSHOT_WINDOW=3
STALE_AFTER_MINUTES=90
SHORTLIST_SIZE=6
# Pump watchlist size (dashboard, MCP, Telegram table); the top SHORTLIST_SIZE go to the agents.
RECOMMENDATIONS_MAX=10
MIN_VOLUME_24H_USD=250000
MIN_MARKET_CAP_USD=5000000
# 0 = keep all history (recommended for research/backtesting).
RETENTION_SNAPSHOT_DAYS=0
# Storage policy for the full universe (~8k coins/hour): after N days, coins outside the strategy
# floors keep only their first snapshot of each UTC day (rows within 72 h of any hour a coin
# qualified stay hourly) and recomputable feature/screening rows are pruned. 0 keeps all detail
# (about 7 MB per hour of snapshots for the full listing).
RETENTION_DETAIL_DAYS=30

# --- Claude Agent SDK ---------------------------------------------------------------
# fixture = deterministic offline stand-in (no model calls), claude = real SDK agents, off
AGENT_PROVIDER=fixture
# Long-lived token from `claude setup-token` (Claude subscription). Server-side only.
CLAUDE_CODE_OAUTH_TOKEN=
AGENT_MODEL_ANALYST=claude-sonnet-5-5
AGENT_MODEL_REVIEWER=claude-sonnet-5-5
AGENT_MODEL_ESCALATION=claude-opus-5-5
AGENT_MODEL_COORDINATOR=claude-haiku-5-5
AGENT_RUN_BUDGET_USD=1.50
AGENT_DAILY_BUDGET_USD=20
AGENT_TIMEOUT_SECONDS=240

# --- Telegram -----------------------------------------------------------------------
# disabled | dry_run | live   (live requires both values below)
TELEGRAM_MODE=dry_run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- MCP and dashboard --------------------------------------------------------------
MCP_HTTP_ENABLED=true
# Bearer tokens for the HTTP MCP endpoint. Read token: read tools. Write token: also publish.
# Leave empty to disable that scope over HTTP.
MCP_READ_TOKEN=
MCP_WRITE_TOKEN=
# Optional "user:password" for dashboard Basic auth (required if HOST is not loopback).
DASHBOARD_BASIC_AUTH=

# --- Paper trading assumptions ------------------------------------------------------
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=30

# --- Volume / Market Cap baseline collection (docs/volume-mcap.md) -------------------
# Uses CMC_API_KEY above (a CoinMarketCap key; never the Claude token).
# Explicit CoinMarketCap numeric ids. EMPTY = nothing monitored (no implicit universe).
# Example only (from the brief's screenshots): 1 = Bitcoin, 1027 = Ethereum, 2 = Litecoin
VMC_ASSET_IDS=
# fixture = offline synthetic (default) | cmc = Pro API | cmc_web = website (no key)
# cmc_web requires VMC_DAILY_CONVENTION=ohlcv below.
VMC_SOURCE=fixture
# Plan you believe the key is on; confirmed by `npm run cli -- vmc:probe`.
CMC_PLAN=basic
# eod_quote (v3 quotes/historical daily; Basic plan) | ohlcv (v2 ohlcv/historical; plan-dependent)
VMC_DAILY_CONVENTION=eod_quote
VMC_BASELINE_MONTHS=6
# Baseline is "full" only when valid days / expected days >= this and history covers the window.
VMC_MIN_BASELINE_COVERAGE=0.95
VMC_DAILY_REFRESH_LOOKBACK_DAYS=14
VMC_EOD_MAX_OFFSET_MINUTES=60
VMC_RECENT_WINDOW_HOURS=72
VMC_STALE_AFTER_MINUTES=90
VMC_SCHEDULER_ENABLED=false
VMC_HOURLY_CRON=5 * * * *
# Weekly baseline refresh: Monday 01:30 UTC
VMC_BASELINE_CRON=30 1 * * 1
VMC_REQUESTS_PER_MINUTE=20
VMC_MAX_RETRIES=3
# Requests are strictly sequential (concurrency 1), spaced by VMC_REQUESTS_PER_MINUTE.
VMC_LATEST_BATCH_SIZE=100
# Local guard below the plan's monthly credits (Basic: 15,000).
VMC_MONTHLY_CREDIT_BUDGET=10000
# table | json ; optional file written after each hourly run
VMC_OUTPUT_FORMAT=table
VMC_OUTPUT_FILE=
