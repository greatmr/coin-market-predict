# Coins Predicts — server environment. Copy to .env (on the server: .env.prod). NEVER commit real
# secrets. Every secret can alternatively be supplied as <NAME>_FILE=/path/to/file (Docker secrets).
# Strategy: docs/strategy-two-tier-vmc.md. Operator guide: docs/operator-guide.md.
#
# Only what the dashboard cannot or should not manage lives here: the database connection, the
# listen address, credentials, the reverse-proxy / cookie set-up and file paths. The operational
# settings (data source, schedule, request budgets, Tier 1 collection bounds, LBank list cadence,
# retention, Telegram mode, display time zone, session length, MCP over HTTP) are managed in the
# dashboard under Settings (owner only), stored in the database and validated together with this
# file (docs/adr/0005-dashboard-settings.md, operator-guide § 3b).
#
# A setting placed here still works and takes precedence: the dashboard shows it locked. Use that to
# pin a value, or to override one for a single command:
#   TELEGRAM_MODE=dry_run npm run cli -- run-once
# Every setting, its value and where it comes from: `npm run cli -- settings:list`.

# --- Server ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# --- Database -------------------------------------------------------------------------
DATABASE_URL=postgresql://coins:coins_dev_password@127.0.0.1:5433/coins
# Or leave DATABASE_URL empty and set the parts. docker compose also reads POSTGRES_USER,
# POSTGRES_PASSWORD and POSTGRES_DB from this file for the database container.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433
# POSTGRES_USER=coins
# POSTGRES_PASSWORD=
# POSTGRES_DB=coins
# true = TLS with server-certificate verification (to skip verification, put
# sslmode=no-verify in DATABASE_URL instead).
POSTGRES_SSL=false
# true = log every SQL statement (development only).
DB_LOGGING=false
# Separate database used by `npm run test:e2e` (created and migrated automatically; the name
# must contain "test").
TEST_DATABASE_URL=postgresql://coins:coins_dev_password@127.0.0.1:5433/coins_test

# --- Credentials ----------------------------------------------------------------------
# Telegram bot from @BotFather. Delivery mode (disabled | dry_run | live) is a dashboard setting;
# live needs both values. The chat id is the bot owner, who approves other members.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Official API keys, needed only when Settings selects DATA_SOURCE coinmarketcap / coingecko
# (listings only; the CMC website collector needs no key).
CMC_API_KEY=
COINGECKO_API_KEY=
# Bearer tokens for the HTTP MCP endpoint, at least 24 characters (`openssl rand -hex 24`).
# Empty = MCP over HTTP stays off; "MCP over HTTP" in Settings can also turn it off.
MCP_READ_TOKEN=
MCP_WRITE_TOKEN=
# Password of the owner created on an empty database (at least 8 characters). Unset: "owner".
# It must be changed at the first sign-in either way.
INITIAL_OWNER_PASSWORD=

# --- Behind a reverse proxy -----------------------------------------------------------
# Express "trust proxy" (e.g. loopback, or the number of proxy hops): real client addresses and
# HTTPS detection for the session cookie.
# TRUST_PROXY=loopback
# Secure flag of the session cookie: auto = only when the request arrived over HTTPS.
COOKIE_SECURE=auto

# --- Files ----------------------------------------------------------------------------
# Versioned classification / LBank mapping overrides (reviewed changes only).
TIER1_OVERRIDES_FILE=config/tier1-overrides.json
# Per-batch CSV + XLSX exports (Settings → Retention prunes old export folders).
TIER1_EXPORT_DIR=var/exports
